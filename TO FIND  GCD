public class Main
{
    public static int ram(int a,int b)
    {
        int big=Math.max(a,b);
        int small=Math.min(a,b);
        while(small!=0)
        {
            int rem=big%small;
            big=small;
            small=rem;
        }
        return big;
    }
   
    
	public static void main(String[] args) 
	{
	    int a[]={15,30,50,40,65,80};
	    int gcd=a[0];
	    for(int i=1;i<6;i++)
	    {
	        gcd=ram(gcd,a[i]);
	    }
	    
	    System.out.println("The GCD is "+gcd);
    }
}



