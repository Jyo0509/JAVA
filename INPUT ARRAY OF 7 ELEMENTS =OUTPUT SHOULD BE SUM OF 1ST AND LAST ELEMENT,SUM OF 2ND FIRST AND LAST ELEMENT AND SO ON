import java.util.Arrays;
public class Main
{
	public static void main(String[] args)
	{
	    int[] a={5,10,15,20,15,20,50};
	    int lt=0;
	    int rt=a.length-1;
	    while(lt<rt)
	    {
	        System.out.println(a[lt]+a[rt]);
	        lt++;
	        rt--;
	    }
	    if(lt==rt)
	    {
	        System.out.println(a[rt]);
	    }
	 }
}
