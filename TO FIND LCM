public class Main
{
    public static int san(int a,int b)
    {
        int big=Math.max(a,b);
        int small=Math.min(a,b);
        int s=big;
        while (true)
        {
            if(big%small==0)
            break;
            big=big+s;
        }
        return big;
        
        
    }
	public static void main(String[] args) {
		int a[]={8,10,24,60,20,18,36};
		int lcm=a[0];
		for(int i=0;i<7;i++)
		{
		    lcm=san(lcm,a[i]);
		}
		System.out.println("The LCM is "+lcm);
	}
}



OUTPUT :
The LCM is 360
